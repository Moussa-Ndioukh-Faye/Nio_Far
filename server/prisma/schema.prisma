generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameCategory {
  CONNAISSANCE // "À quel point tu me connais ?", devinez-vous
  ACTION_VERITE
  FUN
  ROMANTIC
  PROFOND
  FLIRT
  COMPETITION
}

enum Difficulty {
  SOFT
  NORMAL
  INTENSE
}

enum GameType {
  GUESS_ME             // "À quel point tu me connais ?"            -> CONNAISSANCE (standard)
  GUESS_MY_ANSWER      // "Devine ma réponse"                       -> CONNAISSANCE (standard)
  WHO_KNOWS_BEST       // "Qui connaît le mieux l'autre ?"          -> CONNAISSANCE (standard)
  TRUTH_OR_DARE        // "Action ou Vérité"                        -> ACTION_VERITE (turnBased)
  TRUTH                // "Vérité"                                  -> ACTION_VERITE (turnBased)
  DARE                 // "Action"                                  -> ACTION_VERITE (turnBased)
  WHO_IS_MORE          // "Qui de nous deux ?"                      -> FUN (standard)
  WOULD_YOU_RATHER     // "Tu préfères ?"                           -> FUN (standard)
  NO_YES_NO            // "Ni oui ni non"                           -> FUN (turnBased)
  MIME_PARTNER         // "Mime ton partenaire"                     -> FUN (turnBased)
  COMPLIMENT_CHALLENGE // "Compliment Challenge"                    -> ROMANTIC (turnBased)
  OUR_MEMORIES         // "Nos souvenirs"                           -> ROMANTIC (standard)
  COMPLETE_THE_SENTENCE// "Complète ma phrase"                      -> ROMANTIC (standard)
  FIVE_THINGS          // "5 choses que j'aime chez toi"            -> ROMANTIC (turnBased)
  DEEP_QUESTIONS       // "Questions profondes"                     -> PROFOND (standard)
  OUR_DREAMS           // "Nos rêves"                               -> PROFOND (standard)
  OUR_FUTURE           // "Notre futur"                             -> PROFOND (standard)
  OUR_VALUES           // "Nos valeurs"                             -> PROFOND (standard)
  FLIRT_QUESTIONS      // "Questions de flirt"                      -> FLIRT (standard)
  SEDUCTION_CHALLENGES // "Défis de séduction"                      -> FLIRT (turnBased)
  IMPOSSIBLE_CHOICE    // "Choix impossible"                        -> FLIRT (standard)
  COUPLE_BATTLE        // "Couple Battle"                           -> COMPETITION (standard)
  TIMED_QUIZ           // "Quiz chronométré"                        -> COMPETITION (standard)
  SPEED_DUEL           // "Duel de rapidité"                        -> COMPETITION (standard)
}

enum SessionStatus {
  WAITING
  READY
  PLAYING
  REVEALING // conservé pour compat avec d'anciennes sessions
  FINISHED
  ABANDONED
}

// Optionnel pour le MVP (pas de compte obligatoire), prévu pour plus tard.
model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  players   Player[]
}

model GameSession {
  id             String        @id @default(cuid())
  code           String        @unique // ex: NF-82K7
  gameType       GameType
  category       GameCategory  @default(CONNAISSANCE)
  difficulty     Difficulty    @default(SOFT)
  scoringEnabled Boolean       @default(true)
  totalRounds    Int           @default(20)
  status         SessionStatus @default(WAITING)
  hostPlayerId   String?
  currentQuestionIndex Int     @default(0)
  questionOrder  String[]      // ids de cartes dans l'ordre servi à cette session
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  expiresAt      DateTime      // parties abandonnées nettoyées après expiration

  players     Player[]
  answers     Answer[]
  results     GameResult[]
  chatMessages ChatMessage[]
  events      GameEvent[]

  @@index([code])
  @@index([status])
  @@index([category])
}

model Player {
  id            String   @id @default(cuid())
  displayName   String
  sessionId     String
  session       GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  deviceId      String?  // identité anonyme de l'appareil, remonte l'historique de jeu
  socketId      String?
  isConnected   Boolean  @default(true)
  isReady       Boolean  @default(false)
  score         Int      @default(0)
  joinedAt      DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  answers       Answer[]
  chatMessages  ChatMessage[]

  @@index([sessionId])
  @@index([deviceId])
  @@unique([sessionId, socketId])
}

// Catalogue de contenu générique : questions, vérités, défis, prompts.
model GameCard {
  id         String        @id @default(cuid())
  gameType   GameType
  category   GameCategory
  difficulty Difficulty    @default(NORMAL)
  type       String        // "QUESTION" | "TRUTH" | "DARE" | "CHALLENGE" | "PROMPT"
  content    String
  options    String[]      // options prédéfinies (vide si sans choix)
  points     Int?          // points de base optionnels
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())

  @@index([gameType, difficulty])
  @@index([category, difficulty])
  @@index([isActive])
}

model Answer {
  id          String   @id @default(cuid())
  sessionId   String
  session     GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  questionIndex Int    // position dans questionOrder, pour retrouver la carte
  value       String   // réponse brute (option choisie, "MOI"/"MON PARTENAIRE", etc.)
  submittedAt DateTime @default(now())

  @@unique([sessionId, playerId, questionIndex])
  @@index([sessionId, questionIndex])
}

model GameResult {
  id              String   @id @default(cuid())
  sessionId       String
  session         GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  coupleScorePct  Int      // ex: 87
  player1Score    Int
  player2Score    Int
  matchingAnswers Int
  differentAnswers Int
  bestStreak      Int
  createdAt       DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

// Log d'audit de tous les événements serveur-autoritaires (anti-triche, debug, reconnexion)
model GameEvent {
  id        String   @id @default(cuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      String   // ex: "ROOM_CREATED", "GAME_STARTED", "GAME_ACT", "FINISHED"
  payload   Json?
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}